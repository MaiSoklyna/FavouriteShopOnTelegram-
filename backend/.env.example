# Backend Environment Variables
# Copy to .env and fill in your values

# ── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=YourBot_bot

# ── App ─────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend URLs ───────────────────────────────────────
WEB_APP_URL=https://your-miniapp.example.com
ADMIN_PANEL_URL=https://your-dashboard.example.com

# ── CORS (comma-separated) ─────────────────────────────
CORS_ORIGINS=https://your-miniapp.example.com,https://your-dashboard.example.com

# ── Admin Telegram IDs (comma-separated) ────────────────
ADMIN_USER_IDS=123456789

# ── Supabase ────────────────────────────────────────────
# New canonical names (old NEXT_PUBLIC_* names still work for migration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret


# ── Support ─────────────────────────────────────────────
SUPPORT_GROUP_ID=0

# ── OpenAI (optional) ──────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── ABA PayWay (QR payments) ────────────────────────────
# Register sandbox: https://sandbox.payway.com.kh/register-sandbox/
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Public URL; whitelist its domain in your PayWay merchant profile
PAYWAY_CALLBACK_URL=https://your-backend.vercel.app/api/payments/payway/callback
PAYWAY_QR_LIFETIME_MINUTES=15
# Split payments to seller ABA accounts via PayWay `payout`.
# Keep false until ABA's integration team enables Split & Payout.
PAYWAY_PAYOUT_ENABLED=false

# ── Settlement ──────────────────────────────────────────
# Default platform commission %, overridable per merchant
PLATFORM_COMMISSION_PERCENT=0
# true = commission also applies to the delivery fee
COMMISSION_INCLUDES_DELIVERY=false
