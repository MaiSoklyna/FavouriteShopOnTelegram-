# Backend Environment Variables
# Copy to .env and fill in your values

# ── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=YourBot_bot

# ── App ─────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend URLs ───────────────────────────────────────
WEB_APP_URL=https://your-miniapp.example.com
ADMIN_PANEL_URL=https://your-dashboard.example.com

# ── CORS (comma-separated) ─────────────────────────────
CORS_ORIGINS=https://your-miniapp.example.com,https://your-dashboard.example.com

# ── Admin Telegram IDs (comma-separated) ────────────────
ADMIN_USER_IDS=123456789

# ── Supabase ────────────────────────────────────────────
# New canonical names (old NEXT_PUBLIC_* names still work for migration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret


# ── Support ─────────────────────────────────────────────
SUPPORT_GROUP_ID=0

# ── OpenAI (optional) ──────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
