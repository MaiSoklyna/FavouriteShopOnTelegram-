{
  "name": "favourite-of-shop",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages@1",
