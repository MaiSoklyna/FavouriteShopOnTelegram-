# Frontend Environment Variables
# Copy to .env.local and fill in your values

# Backend API URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mapbox public token (pk.…) — maps, geocoding. Restrict it to your domains in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Telegram Bot Username (for login links)
NEXT_PUBLIC_BOT_USERNAME=YourBot_bot

# Supabase URL (only for image URLs — NOT for API calls)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://vovopiuloxhhywfhltdi.supabase.co"
# Stripe test mode (publishable key, pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Online methods shown at checkout: stripe, khqr (COD is always on)
NEXT_PUBLIC_PAYMENT_METHODS=stripe
